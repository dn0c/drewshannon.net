{{!< default}}

<main class="site-main">

    {{#post}}
        <article class="single {{post_class}}">
            <header class="single-header gh-canvas">
                <h1 class="single-title">{{title}}</h1>
                {{#if custom_excerpt}}
                    <div class="single-excerpt">{{custom_excerpt}}</div>
                {{/if}}
            </header>

            {{#if content}}
                <div class="single-content gh-content gh-canvas">
                    {{content}}
                </div>
            {{/if}}
        </article>
    {{/post}}

    <div class="topics-container gh-canvas">

        {{!-- Section 1: Featured Topics (Tags with descriptions) --}}
        <section class="topics-section">
            {{#get "tags" limit="100" include="count.posts" filter="description:-null" order="count.posts desc"}}
                <div class="topics-section-header">
                    <h2 class="topics-section-title">Featured Topics</h2>
                    <span class="topics-section-count">{{plural pagination.total empty=(t "0 Topics") singular=(t "1 Topic") plural=(t "% Topics")}}</span>
                </div>
                <div class="topics-grid">
                    {{#foreach tags}}
                        {{> "topic-card"}}
                    {{/foreach}}
                </div>
            {{/get}}
        </section>

        {{!-- Section 2: Remaining Topics --}}
        <section class="topics-section">
            {{#get "tags" limit="all" include="count.posts" filter="description:null" order="count.posts desc"}}
                <div class="topics-section-header">
                    <h2 class="topics-section-title">More Topics</h2>
                    <span class="topics-section-count">{{plural pagination.total empty=(t "0 Topics") singular=(t "1 Topic") plural=(t "% Topics")}}</span>
                </div>
                <div class="topics-tags-cloud">
                    {{#foreach tags}}
                        <a class="topic-tag-pill" href="{{url}}">
                            <span class="topic-tag-name">{{name}}</span>
                            <span class="topic-tag-count">({{count.posts}})</span>
                        </a>
                    {{/foreach}}
                </div>
            {{/get}}
        </section>

    </div>

</main>
