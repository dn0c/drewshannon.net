<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<script>
(function() {
    const GCS_MANIFEST_URL = 'https://storage.googleapis.com/wideweb-assets-drew/curation_public.json';
    const GCS_RECENT_URL = 'https://storage.googleapis.com/wideweb-assets-drew/curation_recent.json';
    const ITEMS_PER_PAGE = 36;

    let allAtoms = [];
    let filteredAtoms = [];
    let displayedCount = 0;
    let activeFilter = 'all';
    let searchQuery = '';
    let counts = { all: 0, video: 0, quote: 0, image: 0, bookmark: 0, article: 0, note: 0 };
    let fullCatalogLoaded = false;
    let activeSort = 'random'; // 'random' (default UI) or 'recent'
    let shuffledAtoms = [];

    window.currentReaderAtomId = null;
    window.currentMetaAtomId = null;

    // Check optional sort parameter from URL (?sort=recent or ?sort=random)
    try {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('sort') === 'recent') {
            activeSort = 'recent';
        }
    } catch(e) {}

    function updateSortUI() {
        document.querySelectorAll('.cur-sort-btn').forEach(btn => {
            btn.classList.toggle('active', btn.dataset.sort === activeSort);
        });
        const shuffleBtn = document.getElementById('curShuffleBtn');
        if (shuffleBtn) {
            shuffleBtn.style.display = activeSort === 'random' ? 'inline-flex' : 'none';
        }
    }

    function shuffleArray(arr) {
        const a = arr.slice();
        for (let i = a.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            const temp = a[i];
            a[i] = a[j];
            a[j] = temp;
        }
        return a;
    }

    function reshuffle(scrollUp = false) {
        if (!allAtoms || allAtoms.length === 0) return;
        shuffledAtoms = shuffleArray(allAtoms);
        applyFilters(true);
        if (scrollUp) {
            const header = document.querySelector('.curation-header');
            if (header) {
                header.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }
    }

    function updateCountsAndBadges(atoms) {
        counts = { all: atoms.length, video: 0, quote: 0, image: 0, bookmark: 0, article: 0, note: 0 };
        atoms.forEach(a => {
            if (counts[a.kind] !== undefined) counts[a.kind]++;
        });

        for (const [k, v] of Object.entries(counts)) {
            const b = document.getElementById(`badge-${k}`);
            if (b) b.textContent = `(${v.toLocaleString()})`;
        }
        const searchInput = document.getElementById('curationSearch');
        if (searchInput) {
            searchInput.placeholder = `Search ${counts.all.toLocaleString()}+ items by title, author, tag, note... (Press /)`;
        }
    }

    async function loadCurationData() {
        const statusEl = document.getElementById('curationStatus');
        updateSortUI();

        // Stage 0: Instant restore from client cache if available (0ms) - only if user specifically requested 'recent'
        if (activeSort === 'recent') {
            try {
                const cached = localStorage.getItem('webtack_garden_recent_v1') || localStorage.getItem('wideweb_garden_recent_v1');
                if (cached) {
                    const parsed = JSON.parse(cached);
                    if (Array.isArray(parsed) && parsed.length > 0) {
                        allAtoms = parsed;
                        updateCountsAndBadges(allAtoms);
                        if (statusEl) statusEl.style.display = 'none';
                        applyFilters();
                    }
                }
            } catch (e) {}
        }

        // Stage 1: Quick fetch of recent batch (~32 KB gzipped, renders in ~50ms)
        fetch(GCS_RECENT_URL)
            .then(r => r.ok ? r.json() : null)
            .then(recentItems => {
                if (recentItems && recentItems.length) {
                    try { localStorage.setItem('webtack_garden_recent_v1', JSON.stringify(recentItems)); } catch(e){}
                    if (!fullCatalogLoaded) {
                        if (activeSort === 'recent') {
                            allAtoms = recentItems;
                            updateCountsAndBadges(allAtoms);
                            if (statusEl) statusEl.style.display = 'none';
                            applyFilters();
                        } else if (allAtoms.length === 0) {
                            // Seed counts while full catalog streams in
                            updateCountsAndBadges(recentItems);
                        }
                    }
                }
            })
            .catch(() => {});

        // Stage 2: Stream full public catalog (~3 MB gzipped, complete with all public atoms)
        try {
            const resp = await fetch(GCS_MANIFEST_URL);
            if (!resp.ok) throw new Error('HTTP ' + resp.status);
            const fullItems = await resp.json();
            fullCatalogLoaded = true;
            allAtoms = fullItems;

            if (activeSort === 'random') {
                shuffledAtoms = shuffleArray(allAtoms);
            }

            updateCountsAndBadges(allAtoms);
            if (statusEl) statusEl.style.display = 'none';
            applyFilters(true);
        } catch (err) {
            if (allAtoms.length === 0) {
                // Fallback to recent batch if full catalog fails to load
                try {
                    const cached = localStorage.getItem('webtack_garden_recent_v1') || localStorage.getItem('wideweb_garden_recent_v1');
                    if (cached) {
                        const parsed = JSON.parse(cached);
                        if (Array.isArray(parsed) && parsed.length > 0) {
                            allAtoms = parsed;
                            shuffledAtoms = shuffleArray(allAtoms);
                            updateCountsAndBadges(allAtoms);
                            if (statusEl) statusEl.style.display = 'none';
                            applyFilters(true);
                            return;
                        }
                    }
                } catch(e) {}
                if (statusEl) {
                    statusEl.innerHTML = `⚠️ Error loading curation library: ${err.message}. Please check back shortly.`;
                }
            }
        }
    }

    function applyFilters(forceRerender = false) {
        const sourcePool = (activeSort === 'random')
            ? (shuffledAtoms.length ? shuffledAtoms : allAtoms)
            : allAtoms;

        const q = searchQuery.toLowerCase();
        filteredAtoms = sourcePool.filter(a => {
            if (activeFilter !== 'all' && a.kind !== activeFilter) return false;
            if (q) {
                const matchTitle = (a.title || '').toLowerCase().includes(q);
                const matchAuthor = (a.author || '').toLowerCase().includes(q);
                const matchExcerpt = (a.excerpt || '').toLowerCase().includes(q);
                const matchNotes = (a.notes || '').toLowerCase().includes(q);
                const matchTags = (a.tags || []).some(t => t.toLowerCase().includes(q));
                if (!matchTitle && !matchAuthor && !matchExcerpt && !matchNotes && !matchTags) return false;
            }
            return true;
        });

        const grid = document.getElementById('curationGrid');
        const footer = document.getElementById('curationFooter');

        // If cards are already displayed on screen and no filter/search/sort change, don't re-render or shift scroll
        if (!forceRerender && grid && grid.children.length > 0 && !q && activeFilter === 'all') {
            if (footer) footer.style.display = displayedCount < filteredAtoms.length ? 'block' : 'none';
            const loadBtn = document.getElementById('loadMoreBtn');
            if (loadBtn) {
                loadBtn.textContent = `Load More (${(filteredAtoms.length - displayedCount).toLocaleString()} remaining)`;
            }
            return;
        }

        displayedCount = 0;
        if (grid) grid.innerHTML = '';
        renderNextBatch();
    }

    function renderNextBatch() {
        const grid = document.getElementById('curationGrid');
        const footer = document.getElementById('curationFooter');
        const nextBatch = filteredAtoms.slice(displayedCount, displayedCount + ITEMS_PER_PAGE);

        if (displayedCount === 0 && nextBatch.length === 0) {
            grid.innerHTML = '<div style="grid-column: 1/-1; text-align: center; padding: 60px 0; color: var(--color-secondary-text, #777);">No matching items found.</div>';
            footer.style.display = 'none';
            return;
        }

        const fragment = document.createDocumentFragment();

        nextBatch.forEach(atom => {
            const card = document.createElement('div');
            card.className = `cur-card cur-${atom.kind}`;

            // Cover
            let coverHtml = '';
            if (atom.cover_url) {
                const ratio = atom.metadata && atom.metadata.aspect_ratio ? `style="aspect-ratio: ${atom.metadata.aspect_ratio};"` : '';
                const isVid = atom.kind === 'video';
                coverHtml = `
                    <div class="cur-card-cover-box">
                        <img class="cur-card-cover" src="${atom.cover_url}" ${ratio} loading="lazy" alt="${escapeHtml(atom.title)}">
                        ${isVid ? '<span class="cur-play-badge">▶ Video</span>' : ''}
                    </div>
                `;
            }

            // Body
            let bodyHtml = '';
            if (atom.kind === 'quote') {
                bodyHtml = `
                    <div class="cur-card-body">
                        <div class="cur-quote-content">“${escapeHtml(atom.excerpt || atom.title)}”</div>
                        ${atom.author ? `<div class="cur-author-byline">— ${escapeHtml(atom.author)}</div>` : ''}
                        ${atom.notes ? `<div class="cur-card-notes">${escapeHtml(atom.notes)}</div>` : ''}
                    </div>
                `;
            } else if (atom.kind === 'note') {
                bodyHtml = `
                    <div class="cur-card-body">
                        <div class="cur-card-title">${escapeHtml(atom.title)}</div>
                        <div class="cur-card-notes">${escapeHtml(atom.excerpt || atom.notes || '')}</div>
                    </div>
                `;
            } else {
                const targetLink = atom.source_url;
                bodyHtml = `
                    <div class="cur-card-body">
                        <div class="cur-card-title">
                            ${targetLink ? `<a href="${targetLink}" target="_blank" rel="noopener">${escapeHtml(atom.title)}</a>` : escapeHtml(atom.title)}
                        </div>
                        ${atom.author ? `<div class="cur-author-byline">${escapeHtml(atom.author)}</div>` : ''}
                        ${atom.notes ? `<div class="cur-card-notes">${escapeHtml(atom.notes)}</div>` : ''}
                    </div>
                `;
            }

            // Tags & Actions
            const tagsHtml = (atom.tags || []).slice(0, 3).map(t => `<span class="cur-tag">#${t}</span>`).join('');
            let actionHtml = '';
            const visitUrl = atom.source_url;
            if (atom.kind === 'video') {
                actionHtml = `<button class="cur-read-btn" style="background:#6B46C1;" onclick="openCurVideo('${atom.id}')">▶ Play</button>`;
            } else if (atom.kind === 'article' || atom.kind === 'note') {
                actionHtml = `<button class="cur-read-btn" onclick="openCurReader('${atom.id}')">📖 Read</button>`;
            } else if (visitUrl) {
                actionHtml = `<a class="cur-read-btn" style="background:transparent; border:1px solid var(--border-color, #ddd); color:inherit; text-decoration:none;" href="${visitUrl}" target="_blank" rel="noopener">↗ Visit</a>`;
            } else if (atom.metadata && atom.metadata.color_palette && atom.metadata.color_palette.length) {
                actionHtml = `<div class="cur-palette-dots">` + atom.metadata.color_palette.slice(0, 3).map(c => `<div class="cur-palette-dot" style="background:${c}"></div>`).join('') + `</div>`;
            }

            card.innerHTML = `
                <div class="cur-card-header">
                    <span class="cur-kind-pill kind-${atom.kind}">${atom.kind}</span>
                    <span>${atom.date || ''}</span>
                </div>
                ${coverHtml}
                ${bodyHtml}
                <div class="cur-card-footer">
                    <div class="cur-tags">${tagsHtml}</div>
                    <div>${actionHtml}</div>
                </div>
            `;

            card.addEventListener('click', (e) => {
                if (e.target.closest('a') || e.target.closest('button')) return;
                openCurMeta(atom.id);
            });

            fragment.appendChild(card);
        });

        grid.appendChild(fragment);
        displayedCount += nextBatch.length;

        footer.style.display = displayedCount < filteredAtoms.length ? 'block' : 'none';
        document.getElementById('loadMoreBtn').textContent = `Load More (${(filteredAtoms.length - displayedCount).toLocaleString()} remaining)`;
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function getVideoEmbedUrl(atom, autoplay = false) {
        const raw = atom.raw || {};
        const content = (raw && (raw.content || raw.payload)) || {};
        const video = content.video || {};
        let url = video.embed_url || atom.source_url || '';
        if (!url) return null;

        let embed = null;
        const ytMatch = url.match(/(?:youtube\.com\/(?:watch\?v=|shorts\/|embed\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
        if (ytMatch && ytMatch[1]) {
            embed = `https://www.youtube.com/embed/${ytMatch[1]}`;
        } else {
            const vimeoMatch = url.match(/vimeo\.com\/(?:video\/)?([0-9]+)/);
            if (vimeoMatch && vimeoMatch[1]) {
                embed = `https://player.vimeo.com/video/${vimeoMatch[1]}`;
            } else if (url.includes('youtube.com/embed/') || url.includes('player.vimeo.com/video/')) {
                embed = url;
            }
        }
        if (embed && autoplay) {
            embed += (embed.includes('?') ? '&' : '?') + 'autoplay=1';
        }
        return embed;
    }

    function renderContentMarkdown(text) {
        if (!text) return '';
        if (window.marked && typeof window.marked.parse === 'function') {
            try {
                return window.marked.parse(text, { breaks: true, gfm: true });
            } catch (e) {
                console.error('Markdown parse error:', e);
            }
        }
        return escapeHtml(text).split(/\n\n+/).map(p => `<p>${p.replace(/\n/g, '<br>')}</p>`).join('');
    }

    window.openCurVideo = function(atomId) {
        openCurMeta(atomId, true);
    };

    window.openCurReader = function(atomId) {
        openCurMeta(atomId);
    };

    window.openMetaFromReader = function() {
        document.getElementById('curReaderModal').close();
        if (window.currentReaderAtomId) openCurMeta(window.currentReaderAtomId);
    };

    window.openCurMeta = function(atomId, autoplayVideo = false) {
        const atom = allAtoms.find(a => a.id === atomId);
        if (!atom) return;
        window.currentMetaAtomId = atom.id;
        window.currentReaderAtomId = atom.id;

        const raw = atom.raw || {};
        const prov = (raw && (raw.source || raw.provenance)) || {};
        const cur = raw.curation || {};
        const modal = document.getElementById('curMetaModal');

        const kindEl = document.getElementById('curMetaKind');
        kindEl.className = `cur-kind-pill kind-${atom.kind}`;
        kindEl.textContent = atom.kind.toUpperCase();
        document.getElementById('curMetaId').textContent = atom.id;

        const targetUrl = atom.source_url || (prov && prov.source_url);
        let siteName = atom.site_name || prov.site_name || '';
        if (!siteName && targetUrl) {
            try {
                siteName = new URL(targetUrl).hostname.replace(/^www\./, '');
            } catch (e) {}
        }

        const bylineParts = [];
        if (atom.author) bylineParts.push(`<strong>${escapeHtml(atom.author)}</strong>`);
        if (siteName) bylineParts.push(`<span>${escapeHtml(siteName)}</span>`);
        if (atom.date) bylineParts.push(`<span>Captured ${escapeHtml(atom.date)}</span>`);

        const fullContent = atom.content || atom.excerpt || '';

        // Dynamic Schema Explorer formatters (automatically captures added/removed fields directly from JSON)
        function formatDynamicValue(val, depth = 0) {
            if (val === null || val === undefined) {
                return '<span class="cur-null">null</span>';
            }
            if (typeof val === 'boolean') {
                return `<span style="font-family:'JetBrains Mono', monospace; font-size:11.5px; color:${val ? '#0D9488' : 'var(--color-secondary-text, #888)'}; font-weight:600;">${val}</span>`;
            }
            if (typeof val === 'number') {
                return `<span style="font-family:'JetBrains Mono', monospace; font-size:11.5px;">${val}</span>`;
            }
            if (typeof val === 'string') {
                if (val.startsWith('http://') || val.startsWith('https://')) {
                    const label = val.length > 48 ? val.slice(0, 45) + '...' : val;
                    return `<a href="${escapeHtml(val)}" target="_blank" rel="noopener" style="color:inherit; text-decoration:underline; word-break:break-all;">${escapeHtml(label)} ↗</a>`;
                }
                return `<span style="text-align:right; max-width:72%; word-break:break-word;">${escapeHtml(val)}</span>`;
            }
            if (Array.isArray(val)) {
                if (!val.length) return '<span class="cur-null">[]</span>';
                const isColorPalette = val.length && val.every(item => typeof item === 'string' && /^#[0-9A-Fa-f]{3,8}$/.test(item));
                if (isColorPalette) {
                    return `<div style="display:inline-flex; gap:5px; align-items:center; flex-wrap:wrap; justify-content:flex-end;">` +
                        val.map(c => `<span style="display:inline-flex; align-items:center; gap:3px; font-family:'JetBrains Mono', monospace; font-size:10.5px;"><span style="display:inline-block; width:11px; height:11px; border-radius:50%; background:${c}; border:1px solid rgba(0,0,0,0.15);"></span>${c}</span>`).join(' ') +
                        `</div>`;
                }
                return `<div style="display:inline-flex; flex-wrap:wrap; gap:4px; justify-content:flex-end;">${val.map(v => `<span class="cur-tag">#${escapeHtml(String(v))}</span>`).join('')}</div>`;
            }
            if (typeof val === 'object') {
                const keys = Object.keys(val);
                if (!keys.length) return '<span class="cur-null">{}</span>';
                return `<div style="display:flex; flex-direction:column; gap:4px; width:100%; margin-top:3px;">` +
                    keys.map(k => `
                        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:8px; padding:3px 8px; background:rgba(0,0,0,0.025); border-radius:4px; font-size:11px;">
                            <span style="font-family:'JetBrains Mono', monospace; opacity:0.75; font-size:10.5px;">${escapeHtml(k)}</span>
                            ${formatDynamicValue(val[k], depth + 1)}
                        </div>
                    `).join('') + `</div>`;
            }
            return escapeHtml(String(val));
        }

        function renderDynamicTier(tierObj) {
            if (!tierObj || typeof tierObj !== 'object' || !Object.keys(tierObj).length) {
                return '<div class="cur-schema-row"><span class="cur-null">(empty layer)</span></div>';
            }
            return Object.entries(tierObj).map(([key, value]) => `
                <div class="cur-schema-row" style="align-items:flex-start;">
                    <span style="font-family:'JetBrains Mono', monospace; font-size:11.5px; opacity:0.85;">${escapeHtml(key)}</span>
                    ${formatDynamicValue(value)}
                </div>
            `).join('');
        }

        function renderSchemaExplorer(targetAtom) {
            const raw = targetAtom.raw || {};
            const prov = (raw && (raw.source || raw.provenance)) || {};
            const cur = raw.curation || {};
            const content = (raw && (raw.content || raw.payload)) || {};
            const rawMeta = (raw && raw.metadata_json) || targetAtom.metadata || {};

            return `
            <div class="cur-modal-meta-divider">
                <span class="cur-modal-meta-label">Webtack Schema Explorer</span>
            </div>

            <div class="cur-schema-card" style="margin-bottom:12px; background:rgba(0,0,0,0.015); border-style:dashed;">
                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                    <div style="display:flex; align-items:center; gap:8px; font-size:12px;">
                        <span class="cur-kind-pill kind-${targetAtom.kind}">${targetAtom.kind}</span>
                        <span style="font-family:'JetBrains Mono', monospace; font-size:11.5px; opacity:0.8;">${escapeHtml(targetAtom.id)}</span>
                        <span style="font-size:11px; opacity:0.5;">• v${raw.version || 3} (Webtack)</span>
                    </div>
                    <div style="font-size:11px; opacity:0.6;">
                        <span>Captured ${formatDynamicValue(raw.created_at || targetAtom.date)}</span>
                        ${raw.updated_at ? ` • <span>Updated ${formatDynamicValue(raw.updated_at)}</span>` : ''}
                    </div>
                </div>
            </div>

            <div class="cur-schema-card">
                <div class="cur-schema-title">Tier 1: Curation Layer</div>
                ${renderDynamicTier(cur)}
            </div>

            <div class="cur-schema-card">
                <div class="cur-schema-title">Tier 2: Source Layer</div>
                ${renderDynamicTier(prov)}
            </div>

            <div class="cur-schema-card">
                <div class="cur-schema-title">Tier 3: Content Layer</div>
                ${renderDynamicTier(content)}
            </div>

            ${rawMeta && Object.keys(rawMeta).length ? `
            <div class="cur-schema-card">
                <div class="cur-schema-title">Overflow Metadata (<code>metadata_json</code>)</div>
                ${renderDynamicTier(rawMeta)}
            </div>` : ''}

            <details style="margin-top:14px; border:1px solid rgba(0,0,0,0.06); border-radius:8px; overflow:hidden;" open>
                <summary style="padding:10px 14px; font-size:12px; font-weight:600; cursor:pointer; background:rgba(0,0,0,0.02); display:flex; justify-content:space-between; user-select:none;">
                    <span>{ } Full <code>atom.json</code> Spec</span>
                    <span style="font-size:11px; opacity:0.6;">raw json</span>
                </summary>
                <div style="padding:12px; font-size:11px; font-family:'JetBrains Mono', monospace; background:rgba(0,0,0,0.01);">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                        <span style="font-size:10.5px; opacity:0.65;">Webtack Data Spec</span>
                        ${targetAtom.atom_url ? `<a href="${targetAtom.atom_url}" target="_blank" rel="noopener" style="font-size:11px; text-decoration:underline; color:inherit;">↗ Open direct atom.json</a>` : ''}
                    </div>
                    <pre style="margin:0; padding:0; overflow:auto; max-height:260px;"><code id="curRawJsonCode">${escapeHtml(JSON.stringify(raw && Object.keys(raw).length ? raw : targetAtom, null, 2))}</code></pre>
                </div>
            </details>
            `;
        }

        const metaCardsHtml = `<div id="curSchemaContainer">${renderSchemaExplorer(atom)}</div>`;

        let bodyHtml = '';

        if (atom.kind === 'quote') {
            const quoteText = fullContent || atom.title;
            bodyHtml = `
                <!-- FULL QUOTE AT THE TOP -->
                <div class="cur-quote-hero">
                    <div class="cur-modal-quote-text">“${escapeHtml(quoteText).replace(/\n/g, '<br>')}”</div>
                    ${atom.author ? `
                        <div class="cur-modal-quote-author">
                            — <strong>${escapeHtml(atom.author)}</strong>
                            ${siteName ? `<span class="cur-author-source">via ${escapeHtml(siteName)}</span>` : ''}
                        </div>
                    ` : ''}
                    ${targetUrl ? `
                        <div class="cur-modal-actions" style="margin-top:16px; margin-bottom:0;">
                            <a href="${targetUrl}" target="_blank" rel="noopener" class="cur-modal-btn">↗ View Source Article</a>
                        </div>
                    ` : ''}
                </div>

                <!-- METADATA UNDERNEATH -->
                ${metaCardsHtml}
            `;
        } else if (atom.kind === 'image') {
            let paletteDots = '';
            if (atom.metadata && atom.metadata.color_palette && atom.metadata.color_palette.length) {
                paletteDots = `<div style="display:flex; gap:6px; align-items:center; margin-bottom:14px; flex-wrap:wrap;">` +
                    atom.metadata.color_palette.map(c => `<span style="display:inline-flex; align-items:center; gap:4px; font-family:'JetBrains Mono', monospace; font-size:11px;"><span style="display:inline-block; width:14px; height:14px; border-radius:50%; background:${c}; border:1px solid rgba(0,0,0,0.15);"></span>${c}</span>`).join(' ') +
                    `</div>`;
            }
            bodyHtml = `
                <!-- FULL IMAGE AT THE TOP -->
                ${atom.cover_url ? `
                    <div class="cur-image-hero">
                        <a href="${atom.cover_url}" target="_blank" rel="noopener" title="Open full resolution in new tab">
                            <img src="${atom.cover_url}" alt="${escapeHtml(atom.title || 'Image asset')}" class="cur-lightbox-img" loading="eager">
                        </a>
                    </div>
                ` : ''}

                ${paletteDots}

                ${(atom.title && !atom.title.startsWith('atm_') && !/^[0-9a-f_-]{10,}$/i.test(atom.title)) ? `
                    <h2 class="cur-modal-title" style="font-size:22px; margin-bottom:6px;">${escapeHtml(atom.title)}</h2>
                ` : ''}

                ${bylineParts.length ? `<div class="cur-modal-byline">${bylineParts.join(' • ')}</div>` : ''}

                ${fullContent ? `
                    <div class="markdown-body" style="margin-bottom:16px;">
                        ${renderContentMarkdown(fullContent)}
                    </div>
                ` : ''}

                ${targetUrl ? `
                    <div class="cur-modal-actions">
                        <a href="${targetUrl}" target="_blank" rel="noopener" class="cur-modal-btn">↗ View Source Image</a>
                    </div>
                ` : ''}

                <!-- METADATA UNDERNEATH -->
                ${metaCardsHtml}
            `;
        } else if (atom.kind === 'video') {
            const embedUrl = getVideoEmbedUrl(atom, autoplayVideo);
            bodyHtml = `
                <!-- FULL VIDEO AT THE TOP -->
                ${embedUrl ? `
                    <div class="cur-modal-video-wrap">
                        <iframe src="${embedUrl}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                    </div>
                ` : (atom.cover_url ? `
                    <div class="cur-modal-cover-wrap">
                        <img src="${atom.cover_url}" alt="${escapeHtml(atom.title)}" class="cur-modal-cover-img">
                    </div>
                ` : '')}

                <h2 class="cur-modal-title">${escapeHtml(atom.title || 'Untitled Video')}</h2>
                ${bylineParts.length ? `<div class="cur-modal-byline">${bylineParts.join(' • ')}</div>` : ''}

                ${targetUrl ? `
                    <div class="cur-modal-actions">
                        <a href="${targetUrl}" target="_blank" rel="noopener" class="cur-modal-btn" style="background:#6B46C1;">▶ Watch on ${escapeHtml(siteName || 'Video Platform')} ↗</a>
                    </div>
                ` : ''}

                ${fullContent ? `
                    <div class="cur-modal-transcript-wrap">
                        <div class="cur-modal-transcript-heading">Transcript / Dialogue</div>
                        <div class="cur-modal-transcript-body">${escapeHtml(fullContent)}</div>
                    </div>
                ` : ''}

                <!-- METADATA UNDERNEATH -->
                ${metaCardsHtml}
            `;
        } else if (atom.kind === 'article') {
            bodyHtml = `
                <!-- FULL ARTICLE AT THE TOP -->
                ${atom.cover_url ? `
                    <div class="cur-modal-cover-wrap">
                        <img src="${atom.cover_url}" alt="${escapeHtml(atom.title)}" class="cur-modal-cover-img" loading="lazy">
                    </div>
                ` : ''}

                <h2 class="cur-modal-title">${escapeHtml(atom.title || 'Untitled Article')}</h2>
                ${bylineParts.length ? `<div class="cur-modal-byline">${bylineParts.join(' • ')}</div>` : ''}

                ${targetUrl ? `
                    <div class="cur-modal-actions">
                        <a href="${targetUrl}" target="_blank" rel="noopener" class="cur-modal-btn">↗ Read on ${escapeHtml(siteName || 'Publisher')}</a>
                    </div>
                ` : ''}

                <div id="curModalArticleText" class="cur-modal-article-text markdown-body">
                    ${fullContent ? renderContentMarkdown(fullContent) : (atom.excerpt ? `
                        <div class="cur-article-excerpt-preview">${renderContentMarkdown(atom.excerpt)}</div>
                    ` : '')}
                    ${(!fullContent && atom.article_url) ? `
                        <div id="curArticleLoading" style="display:flex; align-items:center; gap:8px; padding:12px; margin-top:12px; border-radius:6px; background:rgba(0,0,0,0.03); font-size:13px; color:var(--color-secondary-text, #666);">
                            <span class="cur-loader" style="width:14px; height:14px; margin-right:4px;"></span>
                            Loading full article text...
                        </div>
                    ` : ''}
                </div>

                <!-- METADATA UNDERNEATH -->
                ${metaCardsHtml}
            `;
        } else if (atom.kind === 'note') {
            bodyHtml = `
                <!-- FULL NOTE AT THE TOP -->
                <h2 class="cur-modal-title">${escapeHtml(atom.title || 'Personal Note')}</h2>
                ${bylineParts.length ? `<div class="cur-modal-byline">${bylineParts.join(' • ')}</div>` : ''}

                <div class="cur-modal-note-text markdown-body">
                    ${renderContentMarkdown(fullContent || atom.notes || '')}
                </div>

                <!-- METADATA UNDERNEATH -->
                ${metaCardsHtml}
            `;
        } else {
            // Bookmark / File / Other
            bodyHtml = `
                ${atom.cover_url ? `
                    <div class="cur-modal-cover-wrap">
                        <img src="${atom.cover_url}" alt="${escapeHtml(atom.title)}" class="cur-modal-cover-img" loading="lazy">
                    </div>
                ` : ''}

                <h2 class="cur-modal-title">${escapeHtml(atom.title || 'Untitled')}</h2>
                ${bylineParts.length ? `<div class="cur-modal-byline">${bylineParts.join(' • ')}</div>` : ''}

                ${targetUrl ? `
                    <div class="cur-modal-actions">
                        <a href="${targetUrl}" target="_blank" rel="noopener" class="cur-modal-btn">↗ Visit Link</a>
                    </div>
                ` : ''}

                ${fullContent ? `
                    <div class="markdown-body" style="margin-bottom:14px;">
                        ${renderContentMarkdown(fullContent)}
                    </div>
                ` : ''}

                <!-- METADATA UNDERNEATH -->
                ${metaCardsHtml}
            `;
        }

        const body = document.getElementById('curMetaBody');
        body.innerHTML = bodyHtml;
        modal.showModal();

        // Lazy-load full article markdown if not already loaded in memory
        if (atom.kind === 'article' && atom.article_url && !atom.content && !atom._loadingArticle) {
            atom._loadingArticle = true;
            fetch(atom.article_url)
                .then(r => {
                    if (!r.ok) throw new Error('HTTP ' + r.status);
                    return r.text();
                })
                .then(text => {
                    atom.content = text;
                    atom._loadingArticle = false;
                    if (window.currentMetaAtomId === atom.id) {
                        const container = document.getElementById('curModalArticleText');
                        if (container) {
                            container.innerHTML = renderContentMarkdown(text);
                        }
                    }
                })
                .catch(err => {
                    atom._loadingArticle = false;
                    const loader = document.getElementById('curArticleLoading');
                    if (loader) {
                        loader.style.display = 'none';
                    }
                });
        }

        // Lazy-load full atom.json schema if not already in memory
        if ((!atom.raw || Object.keys(atom.raw).length === 0) && atom.atom_url && !atom._loadingRaw) {
            atom._loadingRaw = true;
            const fetchUrl = atom.atom_url.includes('?') ? atom.atom_url : `${atom.atom_url}?v=${Date.now()}`;
            fetch(fetchUrl)
                .then(r => {
                    if (!r.ok) throw new Error('HTTP ' + r.status);
                    return r.json();
                })
                .then(rawJson => {
                    atom.raw = rawJson;
                    atom._loadingRaw = false;
                    if (window.currentMetaAtomId === atom.id) {
                        const container = document.getElementById('curSchemaContainer');
                        if (container) {
                            container.innerHTML = renderSchemaExplorer(atom);
                        } else {
                            const codeEl = document.getElementById('curRawJsonCode');
                            if (codeEl) {
                                codeEl.textContent = JSON.stringify(rawJson, null, 2);
                            }
                        }
                    }
                })
                .catch(() => {
                    atom._loadingRaw = false;
                });
        }
    };

    window.copyCurId = function() {
        if (!window.currentMetaAtomId) return;
        navigator.clipboard.writeText(window.currentMetaAtomId).then(() => {
            const btn = document.getElementById('curCopyIdBtn');
            const orig = btn.textContent;
            btn.textContent = '✓ Copied!';
            setTimeout(() => btn.textContent = orig, 1800);
        });
    };

    // Sort Buttons
    document.querySelectorAll('.cur-sort-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const targetSort = btn.dataset.sort;
            if (targetSort === activeSort) {
                // Clicking active Random reshuffles
                if (targetSort === 'random') {
                    reshuffle(true);
                }
                return;
            }
            activeSort = targetSort;
            updateSortUI();
            if (activeSort === 'random' && shuffledAtoms.length === 0 && allAtoms.length > 0) {
                shuffledAtoms = shuffleArray(allAtoms);
            }
            applyFilters(true);
        });
    });

    // Shuffle Button
    const shuffleBtn = document.getElementById('curShuffleBtn');
    if (shuffleBtn) {
        shuffleBtn.addEventListener('click', () => {
            if (activeSort !== 'random') {
                activeSort = 'random';
                updateSortUI();
            }
            reshuffle(true);
        });
    }

    // Filter Buttons
    document.querySelectorAll('.cur-tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.cur-tab-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            activeFilter = btn.dataset.filter;
            applyFilters();
        });
    });

    // Search Input
    document.getElementById('curationSearch').addEventListener('input', (e) => {
        searchQuery = e.target.value.trim();
        applyFilters();
    });

    // Keyboard shortcut '/'
    window.addEventListener('keydown', (e) => {
        if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
        if (e.key === '/') {
            e.preventDefault();
            document.getElementById('curationSearch').focus();
        }
    });

    // Load More Button
    document.getElementById('loadMoreBtn').addEventListener('click', renderNextBatch);

    // Close dialogs on backdrop click
    ['curVideoModal', 'curReaderModal', 'curMetaModal'].forEach(id => {
        const d = document.getElementById(id);
        if (d) {
            d.addEventListener('click', (e) => {
                const r = d.getBoundingClientRect();
                if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) d.close();
            });
            d.addEventListener('close', () => {
                if (id === 'curMetaModal') {
                    const b = document.getElementById('curMetaBody');
                    if (b) b.innerHTML = '';
                } else if (id === 'curVideoModal') {
                    const b = document.getElementById('curVideoBody');
                    if (b) b.innerHTML = '';
                }
            });
        }
    });

    // Init
    loadCurationData();
})();
</script>
