{{!< default}}

<main class="site-main">

    {{#post}}
        <article class="single {{post_class}}">
            <header class="single-header gh-canvas" style="margin-bottom: 24px;">
                <h1 class="single-title">{{title}}</h1>
                {{#if custom_excerpt}}
                    <div class="single-excerpt">{{custom_excerpt}}</div>
                {{/if}}
            </header>

            {{#if content}}
                <div class="single-content gh-content gh-canvas" style="margin-bottom: 24px;">
                    {{content}}
                </div>
            {{/if}}
        </article>
    {{/post}}

    <div class="curation-hub gh-outer">
        <div class="curation-inner">
            <!-- Filter & Search Bar -->
            <div class="curation-header">
                <div class="curation-filters" id="curationFilters">
                    <button class="cur-tab-btn active" data-filter="all">All <span class="cur-badge" id="badge-all">...</span></button>
                    <button class="cur-tab-btn" data-filter="video">🎬 Videos <span class="cur-badge" id="badge-video"></span></button>
                    <button class="cur-tab-btn" data-filter="quote">💬 Quotes <span class="cur-badge" id="badge-quote"></span></button>
                    <button class="cur-tab-btn" data-filter="image">🖼️ Images <span class="cur-badge" id="badge-image"></span></button>
                    <button class="cur-tab-btn" data-filter="bookmark">📦 Bookmarks <span class="cur-badge" id="badge-bookmark"></span></button>
                    <button class="cur-tab-btn" data-filter="article">📖 Articles <span class="cur-badge" id="badge-article"></span></button>
                    <button class="cur-tab-btn" data-filter="note">📝 Notes <span class="cur-badge" id="badge-note"></span></button>
                </div>
                <div class="curation-search-box">
                    <span class="cur-search-icon">🔍</span>
                    <input type="text" id="curationSearch" placeholder="Search 13,700+ items by title, author, tag, note... (Press /)" autocomplete="off">
                </div>
            </div>

            <div class="curation-status" id="curationStatus">
                <div class="cur-loader"></div> Loading living curation library...
            </div>

            <!-- Masonry Grid -->
            <div class="curation-grid" id="curationGrid"></div>

            <!-- Load More Trigger -->
            <div class="curation-footer" id="curationFooter" style="display: none;">
                <button class="cur-more-btn" id="loadMoreBtn">Load More Items</button>
            </div>
        </div>
    </div>

    <!-- Video Modal -->
    <dialog id="curVideoModal" class="cur-dialog">
        <div class="cur-dialog-header">
            <div id="curVideoMeta" class="cur-dialog-meta"></div>
            <button class="cur-dialog-close" onclick="document.getElementById('curVideoModal').close()">✕</button>
        </div>
        <div class="cur-dialog-body" id="curVideoBody"></div>
    </dialog>

    <!-- Reader Modal -->
    <dialog id="curReaderModal" class="cur-dialog">
        <div class="cur-dialog-header">
            <div id="curReaderMeta" class="cur-dialog-meta"></div>
            <div style="display: flex; gap: 8px; align-items: center;">
                <button class="cur-meta-btn" onclick="openMetaFromReader()">ℹ️ Metadata</button>
                <button class="cur-dialog-close" onclick="document.getElementById('curReaderModal').close()">✕</button>
            </div>
        </div>
        <div class="cur-dialog-body" id="curReaderBody"></div>
    </dialog>

    <!-- Metadata Inspector Modal -->
    <dialog id="curMetaModal" class="cur-dialog" style="max-width: 860px; width: 92%;">
        <div class="cur-dialog-header">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span id="curMetaKind" class="cur-kind-pill"></span>
                <span id="curMetaId" class="cur-id-pill"></span>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <button class="cur-meta-btn" id="curCopyIdBtn" onclick="copyCurId()">📋 Copy ID</button>
                <button class="cur-dialog-close" onclick="document.getElementById('curMetaModal').close()">✕</button>
            </div>
        </div>
        <div class="cur-dialog-body" id="curMetaBody"></div>
    </dialog>

</main>

<style>
/* ==========================================================================
   WideWeb Curation Digital Garden Styles
   ========================================================================== */
.curation-hub {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 24px 80px;
}

.curation-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 28px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border-color, rgba(0,0,0,0.08));
}

html[data-theme="dark"] .curation-header {
    border-bottom-color: rgba(255,255,255,0.08);
}

.curation-filters {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    align-items: center;
}

.cur-tab-btn {
    background: transparent;
    border: 1px solid transparent;
    color: var(--color-secondary-text, #666);
    font-size: 13px;
    font-weight: 500;
    padding: 6px 12px;
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.cur-tab-btn:hover {
    color: var(--color-primary-text, #111);
    background: rgba(0,0,0,0.04);
}

html[data-theme="dark"] .cur-tab-btn:hover {
    color: #fbf7f0;
    background: rgba(255,255,255,0.06);
}

.cur-tab-btn.active {
    background: var(--color-primary-text, #111);
    color: #fff;
    font-weight: 600;
}

html[data-theme="dark"] .cur-tab-btn.active {
    background: #fbf7f0;
    color: #111;
}

.cur-badge {
    font-size: 11px;
    opacity: 0.75;
    font-family: 'JetBrains Mono', monospace;
}

.curation-search-box {
    position: relative;
    flex-grow: 1;
    max-width: 440px;
    min-width: 260px;
}

.cur-search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 14px;
    opacity: 0.5;
    pointer-events: none;
}

.curation-search-box input {
    width: 100%;
    padding: 9px 14px 9px 36px;
    border-radius: 20px;
    border: 1px solid var(--border-color, rgba(0,0,0,0.12));
    background: var(--color-card-bg, #fff);
    color: var(--color-primary-text, #111);
    font-size: 13px;
    outline: none;
    transition: all 0.15s ease;
}

html[data-theme="dark"] .curation-search-box input {
    background: rgba(255,255,255,0.04);
    border-color: rgba(255,255,255,0.12);
    color: #fbf7f0;
}

.curation-search-box input:focus {
    border-color: var(--color-primary-text, #111);
    box-shadow: 0 0 0 3px rgba(0,0,0,0.05);
}

html[data-theme="dark"] .curation-search-box input:focus {
    border-color: #fbf7f0;
    box-shadow: 0 0 0 3px rgba(251,247,240,0.1);
}

.curation-status {
    text-align: center;
    padding: 60px 20px;
    color: var(--color-secondary-text, #777);
    font-size: 14px;
}

.cur-loader {
    display: inline-block;
    width: 20px;
    height: 20px;
    border: 2px solid rgba(0,0,0,0.15);
    border-top-color: var(--color-primary-text, #111);
    border-radius: 50%;
    animation: curSpin 0.7s linear infinite;
    vertical-align: middle;
    margin-right: 8px;
}

html[data-theme="dark"] .cur-loader {
    border-color: rgba(255,255,255,0.15);
    border-top-color: #fbf7f0;
}

@keyframes curSpin {
    to { transform: rotate(360deg); }
}

/* Masonry Grid */
.curation-grid {
    column-count: 4;
    column-gap: 20px;
}

@media (max-width: 1200px) {
    .curation-grid { column-count: 3; }
}

@media (max-width: 860px) {
    .curation-grid { column-count: 2; }
}

@media (max-width: 580px) {
    .curation-grid { column-count: 1; }
}

/* Cards */
.cur-card {
    break-inside: avoid;
    margin-bottom: 20px;
    background: var(--color-card-bg, #ffffff);
    border: 1px solid var(--border-color, rgba(0,0,0,0.08));
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
    cursor: pointer;
    display: flex;
    flex-direction: column;
}

html[data-theme="dark"] .cur-card {
    background: #1a1a19;
    border-color: rgba(255,255,255,0.08);
}

.cur-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.06);
    border-color: rgba(0,0,0,0.18);
}

html[data-theme="dark"] .cur-card:hover {
    box-shadow: 0 8px 24px rgba(0,0,0,0.35);
    border-color: rgba(255,255,255,0.18);
}

.cur-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px 6px;
    font-size: 11px;
    color: var(--color-secondary-text, #888);
}

.cur-kind-pill {
    text-transform: uppercase;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 2px 7px;
    border-radius: 4px;
}

.kind-article { background: rgba(43,76,126,0.12); color: #2B4C7E; }
.kind-bookmark { background: rgba(56,161,105,0.12); color: #38A169; }
.kind-video { background: rgba(107,70,193,0.12); color: #6B46C1; }
.kind-quote { background: rgba(155,44,44,0.12); color: #9B2C2C; }
.kind-note { background: rgba(123,52,30,0.12); color: #7B341E; }
.kind-image { background: rgba(44,122,123,0.12); color: #2C7A7B; }

html[data-theme="dark"] .kind-article { background: rgba(126,166,224,0.15); color: #7EA6E0; }
html[data-theme="dark"] .kind-bookmark { background: rgba(104,211,145,0.15); color: #68D391; }
html[data-theme="dark"] .kind-video { background: rgba(183,148,244,0.15); color: #B794F4; }
html[data-theme="dark"] .kind-quote { background: rgba(254,178,178,0.15); color: #FEB2B2; }
html[data-theme="dark"] .kind-note { background: rgba(246,173,85,0.15); color: #F6AD55; }
html[data-theme="dark"] .kind-image { background: rgba(78,205,196,0.15); color: #4ECDC4; }

.cur-card-cover-box {
    position: relative;
    width: 100%;
    background: rgba(0,0,0,0.03);
}

.cur-card-cover {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
}

.cur-play-badge {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: rgba(0,0,0,0.75);
    color: #fff;
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    gap: 4px;
}

.cur-card-body {
    padding: 12px 14px;
}

.cur-card-title {
    font-family: 'Newsreader', serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-primary-text, #111);
    margin-bottom: 6px;
}

html[data-theme="dark"] .cur-card-title {
    color: #fbf7f0;
}

.cur-card-title a {
    color: inherit;
    text-decoration: none;
}

.cur-card-title a:hover {
    text-decoration: underline;
}

.cur-author-byline {
    font-size: 12px;
    color: var(--color-secondary-text, #777);
    margin-bottom: 8px;
}

.cur-quote-content {
    font-family: 'Newsreader', serif;
    font-style: italic;
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-primary-text, #222);
    margin-bottom: 8px;
}

html[data-theme="dark"] .cur-quote-content {
    color: #e5e0d8;
}

.cur-card-notes {
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--color-secondary-text, #555);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

html[data-theme="dark"] .cur-card-notes {
    color: #a8a49c;
}

.cur-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 14px 12px;
    font-size: 11px;
}

.cur-tags {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    font-family: 'JetBrains Mono', monospace;
}

.cur-tag {
    font-size: 10px;
    color: var(--color-secondary-text, #777);
    background: rgba(0,0,0,0.04);
    padding: 2px 6px;
    border-radius: 4px;
}

html[data-theme="dark"] .cur-tag {
    background: rgba(255,255,255,0.06);
    color: #999;
}

.cur-palette-dots {
    display: flex;
    gap: 3px;
    align-items: center;
}

.cur-palette-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.1);
}

.cur-read-btn {
    background: var(--color-primary-text, #111);
    color: #fff;
    border: none;
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 500;
    cursor: pointer;
}

html[data-theme="dark"] .cur-read-btn {
    background: #fbf7f0;
    color: #111;
}

.curation-footer {
    text-align: center;
    padding: 32px 0;
}

.cur-more-btn {
    background: transparent;
    border: 1px solid var(--border-color, rgba(0,0,0,0.15));
    color: var(--color-primary-text, #111);
    padding: 10px 24px;
    border-radius: 24px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
}

html[data-theme="dark"] .cur-more-btn {
    border-color: rgba(255,255,255,0.15);
    color: #fbf7f0;
}

.cur-more-btn:hover {
    background: rgba(0,0,0,0.04);
}

html[data-theme="dark"] .cur-more-btn:hover {
    background: rgba(255,255,255,0.06);
}

/* Modals */
.cur-dialog {
    border: 1px solid var(--border-color, rgba(0,0,0,0.1));
    border-radius: 14px;
    padding: 0;
    background: var(--color-card-bg, #fff);
    color: var(--color-primary-text, #111);
    box-shadow: 0 20px 50px rgba(0,0,0,0.25);
    width: 90%;
    max-width: 680px;
}

html[data-theme="dark"] .cur-dialog {
    background: #1c1c1b;
    border-color: rgba(255,255,255,0.1);
    color: #fbf7f0;
}

.cur-dialog::backdrop {
    background: rgba(0,0,0,0.75);
    backdrop-filter: blur(8px);
}

.cur-dialog-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 20px;
    border-bottom: 1px solid var(--border-color, rgba(0,0,0,0.08));
}

html[data-theme="dark"] .cur-dialog-header {
    border-bottom-color: rgba(255,255,255,0.08);
}

.cur-dialog-meta {
    font-size: 12px;
    color: var(--color-secondary-text, #777);
    display: flex;
    gap: 8px;
    align-items: center;
}

.cur-dialog-close {
    background: transparent;
    border: none;
    font-size: 16px;
    color: var(--color-secondary-text, #777);
    cursor: pointer;
    padding: 4px;
}

.cur-dialog-body {
    padding: 24px;
    max-height: 75vh;
    overflow-y: auto;
}

.cur-meta-btn {
    background: transparent;
    border: 1px solid var(--border-color, rgba(0,0,0,0.15));
    color: var(--color-primary-text, #111);
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 12px;
    cursor: pointer;
}

html[data-theme="dark"] .cur-meta-btn {
    border-color: rgba(255,255,255,0.15);
    color: #fbf7f0;
}

.cur-id-pill {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--color-secondary-text, #777);
    background: rgba(0,0,0,0.04);
    padding: 2px 6px;
    border-radius: 4px;
}

html[data-theme="dark"] .cur-id-pill {
    background: rgba(255,255,255,0.06);
    color: #aaa;
}

.cur-schema-card {
    background: rgba(0,0,0,0.02);
    border: 1px solid var(--border-color, rgba(0,0,0,0.08));
    border-radius: 8px;
    padding: 14px;
    margin-bottom: 12px;
}

html[data-theme="dark"] .cur-schema-card {
    background: rgba(255,255,255,0.02);
    border-color: rgba(255,255,255,0.08);
}

.cur-schema-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-secondary-text, #888);
    margin-bottom: 8px;
}

.cur-schema-row {
    display: flex;
    justify-content: space-between;
    font-size: 12.5px;
    padding: 5px 0;
    border-bottom: 1px solid rgba(0,0,0,0.04);
    align-items: baseline;
    gap: 12px;
}

.cur-null {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--color-secondary-text, #888);
    opacity: 0.65;
    font-style: italic;
    background: rgba(0,0,0,0.04);
    padding: 1px 5px;
    border-radius: 3px;
    display: inline-block;
}
html[data-theme="dark"] .cur-null {
    background: rgba(255,255,255,0.06);
}

html[data-theme="dark"] .cur-schema-row {
    border-bottom-color: rgba(255,255,255,0.04);
}

/* ==========================================================================
   Full Content in Atom Modal (above metadata)
   ========================================================================== */
.cur-modal-title {
    font-family: 'Newsreader', Georgia, serif;
    font-size: 26px;
    font-weight: 500;
    line-height: 1.3;
    margin: 0 0 8px 0;
    color: var(--color-primary-text, #111);
}

html[data-theme="dark"] .cur-modal-title {
    color: #fbf7f0;
}

.cur-modal-byline {
    font-size: 13px;
    color: var(--color-secondary-text, #777);
    margin-bottom: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
}

.cur-modal-content-section {
    margin-bottom: 24px;
}

.cur-quote-hero {
    border-left: 4px solid var(--color-primary-text, #111);
    background: rgba(0,0,0,0.025);
    padding: 22px 26px;
    border-radius: 0 10px 10px 0;
    margin-bottom: 22px;
}

html[data-theme="dark"] .cur-quote-hero {
    border-left-color: #fbf7f0;
    background: rgba(255,255,255,0.035);
}

.cur-quote-hero .cur-modal-quote-text {
    font-family: 'Newsreader', Georgia, serif;
    font-size: 24px;
    font-style: italic;
    line-height: 1.55;
    margin: 0 0 14px 0;
    color: var(--color-primary-text, #111);
}

html[data-theme="dark"] .cur-quote-hero .cur-modal-quote-text {
    color: #fbf7f0;
}

.cur-quote-hero .cur-modal-quote-author {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--color-secondary-text, #555);
}

html[data-theme="dark"] .cur-quote-hero .cur-modal-quote-author {
    color: #ccc;
}

.cur-author-source {
    font-weight: 400;
    color: var(--color-secondary-text, #777);
    margin-left: 6px;
}

.cur-image-hero {
    text-align: center;
    background: #0d0d0c;
    border-radius: 10px;
    padding: 14px;
    margin-bottom: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
}

.cur-lightbox-img {
    max-width: 100%;
    max-height: 68vh;
    object-fit: contain;
    border-radius: 6px;
    display: block;
    margin: 0 auto;
    box-shadow: 0 4px 24px rgba(0,0,0,0.45);
}

.cur-modal-video-wrap {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: 10px;
    background: #000;
    margin-bottom: 18px;
}

.cur-modal-video-wrap iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
}

.cur-modal-transcript-wrap {
    background: rgba(0,0,0,0.02);
    border: 1px solid var(--border-color, rgba(0,0,0,0.08));
    border-radius: 8px;
    padding: 14px 18px;
    margin-bottom: 18px;
}

html[data-theme="dark"] .cur-modal-transcript-wrap {
    background: rgba(255,255,255,0.02);
    border-color: rgba(255,255,255,0.08);
}

.cur-modal-transcript-heading {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-secondary-text, #888);
    margin-bottom: 8px;
}

.cur-modal-transcript-body {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12.5px;
    line-height: 1.65;
    max-height: 260px;
    overflow-y: auto;
    white-space: pre-wrap;
    color: var(--color-primary-text, #111);
}

html[data-theme="dark"] .cur-modal-transcript-body {
    color: #e2ded5;
}

.cur-modal-actions {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 18px;
}

.cur-modal-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--color-primary-text, #111);
    color: #fff !important;
    text-decoration: none !important;
    font-size: 12.5px;
    font-weight: 500;
    padding: 7px 14px;
    border-radius: 6px;
    transition: opacity 0.15s ease;
    border: none;
    cursor: pointer;
}

.cur-modal-btn:hover {
    opacity: 0.88;
}

html[data-theme="dark"] .cur-modal-btn {
    background: #fbf7f0;
    color: #111 !important;
}

.cur-modal-notes-banner {
    background: rgba(0,0,0,0.02);
    border-left: 3px solid #2B4C7E;
    padding: 12px 16px;
    border-radius: 0 8px 8px 0;
    font-size: 13.5px;
    line-height: 1.6;
    margin-bottom: 18px;
}

html[data-theme="dark"] .cur-modal-notes-banner {
    background: rgba(255,255,255,0.03);
    border-left-color: #63B3ED;
}

.cur-modal-notes-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #2B4C7E;
    margin-bottom: 6px;
}

html[data-theme="dark"] .cur-modal-notes-title {
    color: #63B3ED;
}

.cur-modal-meta-divider {
    display: flex;
    align-items: center;
    text-align: center;
    margin: 32px 0 18px;
}

.cur-modal-meta-divider::before,
.cur-modal-meta-divider::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid var(--border-color, rgba(0,0,0,0.1));
}

html[data-theme="dark"] .cur-modal-meta-divider::before,
html[data-theme="dark"] .cur-modal-meta-divider::after {
    border-bottom-color: rgba(255,255,255,0.1);
}

.cur-modal-meta-label {
    padding: 0 14px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-secondary-text, #888);
}

.markdown-body {
    font-family: 'Newsreader', Georgia, serif;
    font-size: 16.5px;
    line-height: 1.75;
    color: var(--color-primary-text, #111);
}

html[data-theme="dark"] .markdown-body {
    color: #fbf7f0;
}

.markdown-body p {
    margin: 0 0 1.1em 0;
}

.markdown-body h1, .markdown-body h2, .markdown-body h3, .markdown-body h4 {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    margin: 1.4em 0 0.6em;
    font-weight: 600;
    line-height: 1.3;
}

.markdown-body blockquote {
    border-left: 3px solid var(--border-color, rgba(0,0,0,0.18));
    margin: 1.2em 0;
    padding-left: 16px;
    color: var(--color-secondary-text, #666);
    font-style: italic;
}

html[data-theme="dark"] .markdown-body blockquote {
    border-left-color: rgba(255,255,255,0.2);
    color: #aaa;
}

.markdown-body pre, .markdown-body code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    background: rgba(0,0,0,0.04);
    border-radius: 4px;
}

html[data-theme="dark"] .markdown-body pre,
html[data-theme="dark"] .markdown-body code {
    background: rgba(255,255,255,0.06);
}

.markdown-body pre {
    padding: 12px 16px;
    overflow-x: auto;
    margin: 1.2em 0;
}

.markdown-body code {
    padding: 2px 5px;
}

.markdown-body pre code {
    padding: 0;
}

.markdown-body ul, .markdown-body ol {
    margin: 0 0 1.2em 24px;
    padding: 0;
}

.markdown-body li {
    margin-bottom: 0.4em;
}

.markdown-body img {
    max-width: 100%;
    border-radius: 8px;
    margin: 1.2em 0;
}

.markdown-body a {
    color: inherit;
    text-decoration: underline;
}
</style>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<script>
(function() {
    const GCS_MANIFEST_URL = 'https://storage.googleapis.com/wideweb-assets-drew/curation_public.json';
    const ITEMS_PER_PAGE = 36;

    let allAtoms = [];
    let filteredAtoms = [];
    let displayedCount = 0;
    let activeFilter = 'all';
    let searchQuery = '';
    let counts = { all: 0, video: 0, quote: 0, image: 0, bookmark: 0, article: 0, note: 0 };

    window.currentReaderAtomId = null;
    window.currentMetaAtomId = null;

    async function loadCurationData() {
        const statusEl = document.getElementById('curationStatus');
        try {
            const cacheBuster = '?t=' + Math.floor(Date.now() / 60000);
            const resp = await fetch(GCS_MANIFEST_URL + cacheBuster, { cache: 'no-cache' });
            if (!resp.ok) throw new Error('HTTP ' + resp.status);
            allAtoms = await resp.json();

            // Compute counts
            counts.all = allAtoms.length;
            allAtoms.forEach(a => {
                if (counts[a.kind] !== undefined) counts[a.kind]++;
            });

            // Update badge counts and search placeholder
            for (const [k, v] of Object.entries(counts)) {
                const b = document.getElementById(`badge-${k}`);
                if (b) b.textContent = `(${v.toLocaleString()})`;
            }
            const searchInput = document.getElementById('curationSearch');
            if (searchInput) {
                searchInput.placeholder = `Search ${counts.all.toLocaleString()}+ items by title, author, tag, note... (Press /)`;
            }

            statusEl.style.display = 'none';
            applyFilters();
        } catch (err) {
            statusEl.innerHTML = `⚠️ Error loading curation library: ${err.message}. Please check back shortly.`;
        }
    }

    function applyFilters() {
        const q = searchQuery.toLowerCase();
        filteredAtoms = allAtoms.filter(a => {
            if (activeFilter !== 'all' && a.kind !== activeFilter) return false;
            if (q) {
                const matchTitle = (a.title || '').toLowerCase().includes(q);
                const matchAuthor = (a.author || '').toLowerCase().includes(q);
                const matchExcerpt = (a.excerpt || '').toLowerCase().includes(q);
                const matchNotes = (a.notes || '').toLowerCase().includes(q);
                const matchTags = (a.tags || []).some(t => t.toLowerCase().includes(q));
                if (!matchTitle && !matchAuthor && !matchExcerpt && !matchNotes && !matchTags) return false;
            }
            return true;
        });

        displayedCount = 0;
        document.getElementById('curationGrid').innerHTML = '';
        renderNextBatch();
    }

    function renderNextBatch() {
        const grid = document.getElementById('curationGrid');
        const footer = document.getElementById('curationFooter');
        const nextBatch = filteredAtoms.slice(displayedCount, displayedCount + ITEMS_PER_PAGE);

        if (displayedCount === 0 && nextBatch.length === 0) {
            grid.innerHTML = '<div style="grid-column: 1/-1; text-align: center; padding: 60px 0; color: var(--color-secondary-text, #777);">No matching items found.</div>';
            footer.style.display = 'none';
            return;
        }

        const fragment = document.createDocumentFragment();

        nextBatch.forEach(atom => {
            const card = document.createElement('div');
            card.className = `cur-card cur-${atom.kind}`;

            // Cover
            let coverHtml = '';
            if (atom.cover_url) {
                const ratio = atom.metadata && atom.metadata.aspect_ratio ? `style="aspect-ratio: ${atom.metadata.aspect_ratio};"` : '';
                const isVid = atom.kind === 'video';
                coverHtml = `
                    <div class="cur-card-cover-box">
                        <img class="cur-card-cover" src="${atom.cover_url}" ${ratio} loading="lazy" alt="${escapeHtml(atom.title)}">
                        ${isVid ? '<span class="cur-play-badge">▶ Video</span>' : ''}
                    </div>
                `;
            }

            // Body
            let bodyHtml = '';
            if (atom.kind === 'quote') {
                bodyHtml = `
                    <div class="cur-card-body">
                        <div class="cur-quote-content">“${escapeHtml(atom.excerpt || atom.title)}”</div>
                        ${atom.author ? `<div class="cur-author-byline">— ${escapeHtml(atom.author)}</div>` : ''}
                        ${atom.notes ? `<div class="cur-card-notes">${escapeHtml(atom.notes)}</div>` : ''}
                    </div>
                `;
            } else if (atom.kind === 'note') {
                bodyHtml = `
                    <div class="cur-card-body">
                        <div class="cur-card-title">${escapeHtml(atom.title)}</div>
                        <div class="cur-card-notes">${escapeHtml(atom.excerpt || atom.notes || '')}</div>
                    </div>
                `;
            } else {
                const targetLink = atom.source_url || atom.canonical_url;
                bodyHtml = `
                    <div class="cur-card-body">
                        <div class="cur-card-title">
                            ${targetLink ? `<a href="${targetLink}" target="_blank" rel="noopener">${escapeHtml(atom.title)}</a>` : escapeHtml(atom.title)}
                        </div>
                        ${atom.author ? `<div class="cur-author-byline">${escapeHtml(atom.author)}</div>` : ''}
                        ${atom.notes ? `<div class="cur-card-notes">${escapeHtml(atom.notes)}</div>` : ''}
                    </div>
                `;
            }

            // Tags & Actions
            const tagsHtml = (atom.tags || []).slice(0, 3).map(t => `<span class="cur-tag">#${t}</span>`).join('');
            let actionHtml = '';
            const visitUrl = atom.source_url || atom.canonical_url;
            if (atom.kind === 'video') {
                actionHtml = `<button class="cur-read-btn" style="background:#6B46C1;" onclick="openCurVideo('${atom.id}')">▶ Play</button>`;
            } else if (atom.kind === 'article' || atom.kind === 'note') {
                actionHtml = `<button class="cur-read-btn" onclick="openCurReader('${atom.id}')">📖 Read</button>`;
            } else if (visitUrl) {
                actionHtml = `<a class="cur-read-btn" style="background:transparent; border:1px solid var(--border-color, #ddd); color:inherit; text-decoration:none;" href="${visitUrl}" target="_blank" rel="noopener">↗ Visit</a>`;
            } else if (atom.metadata && atom.metadata.color_palette && atom.metadata.color_palette.length) {
                actionHtml = `<div class="cur-palette-dots">` + atom.metadata.color_palette.slice(0, 3).map(c => `<div class="cur-palette-dot" style="background:${c}"></div>`).join('') + `</div>`;
            }

            card.innerHTML = `
                <div class="cur-card-header">
                    <span class="cur-kind-pill kind-${atom.kind}">${atom.kind}</span>
                    <span>${atom.date || ''}</span>
                </div>
                ${coverHtml}
                ${bodyHtml}
                <div class="cur-card-footer">
                    <div class="cur-tags">${tagsHtml}</div>
                    <div>${actionHtml}</div>
                </div>
            `;

            card.addEventListener('click', (e) => {
                if (e.target.closest('a') || e.target.closest('button')) return;
                openCurMeta(atom.id);
            });

            fragment.appendChild(card);
        });

        grid.appendChild(fragment);
        displayedCount += nextBatch.length;

        footer.style.display = displayedCount < filteredAtoms.length ? 'block' : 'none';
        document.getElementById('loadMoreBtn').textContent = `Load More (${(filteredAtoms.length - displayedCount).toLocaleString()} remaining)`;
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function getVideoEmbedUrl(atom, autoplay = false) {
        const raw = atom.raw || {};
        const video = (raw.payload && raw.payload.video) || {};
        let url = video.embed_url || atom.source_url || (prov && prov.canonical_url) || '';
        if (!url) return null;

        let embed = null;
        const ytMatch = url.match(/(?:youtube\.com\/(?:watch\?v=|shorts\/|embed\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
        if (ytMatch && ytMatch[1]) {
            embed = `https://www.youtube.com/embed/${ytMatch[1]}`;
        } else {
            const vimeoMatch = url.match(/vimeo\.com\/(?:video\/)?([0-9]+)/);
            if (vimeoMatch && vimeoMatch[1]) {
                embed = `https://player.vimeo.com/video/${vimeoMatch[1]}`;
            } else if (url.includes('youtube.com/embed/') || url.includes('player.vimeo.com/video/')) {
                embed = url;
            }
        }
        if (embed && autoplay) {
            embed += (embed.includes('?') ? '&' : '?') + 'autoplay=1';
        }
        return embed;
    }

    function renderContentMarkdown(text) {
        if (!text) return '';
        if (window.marked && typeof window.marked.parse === 'function') {
            try {
                return window.marked.parse(text, { breaks: true, gfm: true });
            } catch (e) {
                console.error('Markdown parse error:', e);
            }
        }
        return escapeHtml(text).split(/\n\n+/).map(p => `<p>${p.replace(/\n/g, '<br>')}</p>`).join('');
    }

    window.openCurVideo = function(atomId) {
        openCurMeta(atomId, true);
    };

    window.openCurReader = function(atomId) {
        openCurMeta(atomId);
    };

    window.openMetaFromReader = function() {
        document.getElementById('curReaderModal').close();
        if (window.currentReaderAtomId) openCurMeta(window.currentReaderAtomId);
    };

    window.openCurMeta = function(atomId, autoplayVideo = false) {
        const atom = allAtoms.find(a => a.id === atomId);
        if (!atom) return;
        window.currentMetaAtomId = atom.id;
        window.currentReaderAtomId = atom.id;

        const raw = atom.raw || {};
        const prov = raw.provenance || {};
        const cur = raw.curation || {};
        const modal = document.getElementById('curMetaModal');

        const kindEl = document.getElementById('curMetaKind');
        kindEl.className = `cur-kind-pill kind-${atom.kind}`;
        kindEl.textContent = atom.kind.toUpperCase();
        document.getElementById('curMetaId').textContent = atom.id;

        const targetUrl = atom.source_url || prov.canonical_url || prov.source_url;
        let siteName = atom.site_name || prov.site_name || '';
        if (!siteName && targetUrl) {
            try {
                siteName = new URL(targetUrl).hostname.replace(/^www\./, '');
            } catch (e) {}
        }

        const bylineParts = [];
        if (atom.author) bylineParts.push(`<strong>${escapeHtml(atom.author)}</strong>`);
        if (siteName) bylineParts.push(`<span>${escapeHtml(siteName)}</span>`);
        if (atom.date) bylineParts.push(`<span>Captured ${escapeHtml(atom.date)}</span>`);

        const fullContent = atom.content || atom.excerpt || '';

        // Schema Explorer formatter
        function formatSchemaVal(val, isMono = false, isUrl = false) {
            if (val === null || val === undefined || val === '') {
                return '<span class="cur-null">null</span>';
            }
            if (typeof val === 'boolean') {
                return `<span style="font-family:'JetBrains Mono', monospace; font-size:11.5px; color:${val ? '#0D9488' : 'var(--color-secondary-text, #888)'}; font-weight:600;">${val}</span>`;
            }
            if (Array.isArray(val)) {
                if (!val.length) return '<span class="cur-null">[] (empty)</span>';
                return `<div style="display:inline-flex; flex-wrap:wrap; gap:4px; justify-content:flex-end;">${val.map(v => `<span class="cur-tag">#${escapeHtml(v)}</span>`).join('')}</div>`;
            }
            if (isUrl) {
                const label = val.length > 44 ? val.slice(0, 41) + '...' : val;
                return `<a href="${escapeHtml(val)}" target="_blank" rel="noopener" style="color:inherit; text-decoration:underline; word-break:break-all;">${escapeHtml(label)} ↗</a>`;
            }
            const s = String(val);
            return `<span style="text-align:right; max-width:72%; word-break:break-word; ${isMono ? "font-family:'JetBrains Mono', monospace; font-size:11.5px;" : ""}">${escapeHtml(s)}</span>`;
        }

        const coverPayload = (raw.payload && raw.payload.cover_image) || {};
        const dims = coverPayload.dimensions ? `${coverPayload.dimensions.width} × ${coverPayload.dimensions.height}` : null;
        const ratio = (atom.metadata && atom.metadata.aspect_ratio !== undefined && atom.metadata.aspect_ratio !== null) ? atom.metadata.aspect_ratio : coverPayload.aspect_ratio;
        const blur = (atom.metadata && atom.metadata.blurhash) || coverPayload.blurhash;
        const palette = (atom.metadata && atom.metadata.color_palette && atom.metadata.color_palette.length) ? atom.metadata.color_palette : coverPayload.color_palette;
        let paletteHtml = null;
        if (palette && palette.length) {
            paletteHtml = `<div style="display:inline-flex; gap:5px; align-items:center; flex-wrap:wrap; justify-content:flex-end;">` +
                palette.map(c => `<span style="display:inline-flex; align-items:center; gap:3px; font-family:'JetBrains Mono', monospace; font-size:10.5px;"><span style="display:inline-block; width:11px; height:11px; border-radius:50%; background:${c}; border:1px solid rgba(0,0,0,0.15);"></span>${c}</span>`).join(' ') +
                `</div>`;
        }
        const altTextVal = atom.alt_text || coverPayload.alt_text;
        const wordCount = (atom.metadata && atom.metadata.word_count) || (raw.payload && raw.payload.article && raw.payload.article.word_count) || (raw.payload && raw.payload.text && raw.payload.text.word_count);
        const favDisplay = prov.favicon ? `<span style="display:inline-flex; align-items:center; gap:5px;"><img src="${escapeHtml(prov.favicon)}" style="width:14px;height:14px;border-radius:2px;"> <a href="${escapeHtml(prov.favicon)}" target="_blank" rel="noopener" style="text-decoration:underline;">link ↗</a></span>` : formatSchemaVal(null);

        const rawMeta = (raw && raw.metadata_json) || atom.metadata || {};
        const metaKeys = Object.keys(rawMeta);
        const metaOverflowHtml = metaKeys.length ?
            `<div style="display:inline-flex; flex-wrap:wrap; gap:4px; justify-content:flex-end;">` +
            metaKeys.map(k => `<span class="cur-tag" style="font-family:'JetBrains Mono', monospace; font-size:10.5px;">${escapeHtml(k)}: ${escapeHtml(typeof rawMeta[k] === 'object' && rawMeta[k] !== null ? JSON.stringify(rawMeta[k]) : String(rawMeta[k]))}</span>`).join(' ') +
            `</div>` : formatSchemaVal(null);

        const collectionsList = atom.collections || cur.collections || [];
        const collectionsStr = collectionsList.length ? collectionsList.join(', ') : 'Inbox';

        const metaCardsHtml = `
            <div class="cur-modal-meta-divider">
                <span class="cur-modal-meta-label">OpenCurate Schema Explorer</span>
            </div>

            <div class="cur-schema-card">
                <div class="cur-schema-title">Tier 1: System Envelope</div>
                <div class="cur-schema-row"><span>Atom ID</span><span style="font-family:'JetBrains Mono', monospace;">${escapeHtml(atom.id)}</span></div>
                <div class="cur-schema-row"><span>Kind</span><span class="cur-kind-pill kind-${atom.kind}">${atom.kind}</span></div>
                <div class="cur-schema-row"><span>Version</span><span style="font-family:'JetBrains Mono', monospace;">v${raw.version || 2} (OpenCurate)</span></div>
                <div class="cur-schema-row"><span>Schema Spec</span>${formatSchemaVal(raw['$schema'] || 'https://raw.githubusercontent.com/dn0c/wideweb/main/schema/atom.schema.json', true, true)}</div>
                <div class="cur-schema-row"><span>Captured Date</span>${formatSchemaVal(raw.created_at || atom.date)}</div>
                <div class="cur-schema-row"><span>Updated Date</span>${formatSchemaVal(raw.updated_at)}</div>
            </div>

            <div class="cur-schema-card">
                <div class="cur-schema-title">Tier 2: Provenance Layer</div>
                <div class="cur-schema-row"><span>Author / Creator</span>${formatSchemaVal(atom.author || prov.author)}</div>
                <div class="cur-schema-row"><span>Author URL</span>${formatSchemaVal(prov.author_url, true, true)}</div>
                <div class="cur-schema-row"><span>Publisher / Site</span>${formatSchemaVal(siteName || prov.site_name)}</div>
                <div class="cur-schema-row"><span>Favicon</span>${favDisplay}</div>
                <div class="cur-schema-row"><span>Source Title</span>${formatSchemaVal(prov.source_title)}</div>
                <div class="cur-schema-row"><span>Source URL</span>${formatSchemaVal(atom.source_url || prov.source_url, false, true)}</div>
                <div class="cur-schema-row"><span>Canonical URL</span>${formatSchemaVal(prov.canonical_url, false, true)}</div>
                <div class="cur-schema-row"><span>Published Date</span>${formatSchemaVal(prov.published_at || (atom.metadata && atom.metadata.published_at))}</div>
            </div>

            <div class="cur-schema-card">
                <div class="cur-schema-title">Tier 3: Curation Layer</div>
                <div class="cur-schema-row"><span>Curated Title</span>${formatSchemaVal(atom.title)}</div>
                <div class="cur-schema-row"><span>Visibility</span><span class="cur-vis-badge">${escapeHtml(cur.visibility || 'public')}</span></div>
                <div class="cur-schema-row"><span>Favorite</span>${formatSchemaVal(Boolean(cur.favorite))}</div>
                <div class="cur-schema-row"><span>Collections</span>${(collectionsList && collectionsList.length) ? escapeHtml(collectionsList.join(', ')) : formatSchemaVal(null)}</div>
                <div class="cur-schema-row"><span>Tags</span>${formatSchemaVal(atom.tags)}</div>
                <div class="cur-schema-row"><span>Notes</span>${formatSchemaVal(atom.notes)}</div>
            </div>

            <div class="cur-schema-card">
                <div class="cur-schema-title">Tier 4: Payload Layer</div>
                <div class="cur-schema-row"><span>Alt Text</span>${altTextVal ? `“${escapeHtml(altTextVal)}”` : formatSchemaVal(null)}</div>
                <div class="cur-schema-row"><span>Cover File</span>${formatSchemaVal(coverPayload.file || (atom.cover_url ? 'cover.jpg' : null), true)}</div>
                <div class="cur-schema-row"><span>Dimensions</span>${formatSchemaVal(dims)}</div>
                <div class="cur-schema-row"><span>Aspect Ratio</span>${formatSchemaVal(ratio)}</div>
                <div class="cur-schema-row"><span>Format / MIME</span>${formatSchemaVal(coverPayload.mime_type || (atom.kind === 'image' ? 'image/jpeg' : null), true)}</div>
                <div class="cur-schema-row"><span>Blurhash</span>${formatSchemaVal(blur, true)}</div>
                <div class="cur-schema-row"><span>Palette</span>${paletteHtml || formatSchemaVal(null)}</div>
                <div class="cur-schema-row"><span>SHA-256 Hash</span>${formatSchemaVal(coverPayload.hash, true)}</div>
                <div class="cur-schema-row"><span>Word Count</span>${wordCount ? `${wordCount} words` : formatSchemaVal(null)}</div>
                <div class="cur-schema-row"><span>Text File</span>${formatSchemaVal((raw.payload && raw.payload.text && raw.payload.text.file) || (atom.kind === 'note' ? 'note.md' : null), true)}</div>
                <div class="cur-schema-row"><span>Video Provider</span>${formatSchemaVal(raw.payload && raw.payload.video && raw.payload.video.provider)}</div>
                <div class="cur-schema-row"><span>Embed URL</span>${formatSchemaVal(raw.payload && raw.payload.video && raw.payload.video.embed_url, true, true)}</div>
                <div class="cur-schema-row"><span>metadata_json</span>${metaOverflowHtml}</div>
            </div>

            <details style="margin-top:14px; border:1px solid rgba(0,0,0,0.06); border-radius:8px; overflow:hidden;">
                <summary style="padding:10px 14px; font-size:12px; font-weight:600; cursor:pointer; background:rgba(0,0,0,0.02); display:flex; justify-content:space-between; user-select:none;">
                    <span>{ } Full <code>atom.json</code> Spec</span>
                    <span style="font-size:11px; opacity:0.6;">inspect raw payload</span>
                </summary>
                <pre style="margin:0; padding:12px; font-size:11px; font-family:'JetBrains Mono', monospace; overflow:auto; max-height:240px; background:rgba(0,0,0,0.01);"><code>${escapeHtml(JSON.stringify(raw && Object.keys(raw).length ? raw : atom, null, 2))}</code></pre>
            </details>
        `;

        let bodyHtml = '';

        if (atom.kind === 'quote') {
            const quoteText = fullContent || atom.title;
            bodyHtml = `
                <!-- FULL QUOTE AT THE TOP -->
                <div class="cur-quote-hero">
                    <div class="cur-modal-quote-text">“${escapeHtml(quoteText).replace(/\n/g, '<br>')}”</div>
                    ${atom.author ? `
                        <div class="cur-modal-quote-author">
                            — <strong>${escapeHtml(atom.author)}</strong>
                            ${siteName ? `<span class="cur-author-source">via ${escapeHtml(siteName)}</span>` : ''}
                        </div>
                    ` : ''}
                    ${targetUrl ? `
                        <div class="cur-modal-actions" style="margin-top:16px; margin-bottom:0;">
                            <a href="${targetUrl}" target="_blank" rel="noopener" class="cur-modal-btn">↗ View Source Article</a>
                        </div>
                    ` : ''}
                </div>

                <!-- METADATA UNDERNEATH -->
                ${metaCardsHtml}
            `;
        } else if (atom.kind === 'image') {
            let paletteDots = '';
            if (atom.metadata && atom.metadata.color_palette && atom.metadata.color_palette.length) {
                paletteDots = `<div style="display:flex; gap:6px; align-items:center; margin-bottom:14px; flex-wrap:wrap;">` +
                    atom.metadata.color_palette.map(c => `<span style="display:inline-flex; align-items:center; gap:4px; font-family:'JetBrains Mono', monospace; font-size:11px;"><span style="display:inline-block; width:14px; height:14px; border-radius:50%; background:${c}; border:1px solid rgba(0,0,0,0.15);"></span>${c}</span>`).join(' ') +
                    `</div>`;
            }
            bodyHtml = `
                <!-- FULL IMAGE AT THE TOP -->
                ${atom.cover_url ? `
                    <div class="cur-image-hero">
                        <a href="${atom.cover_url}" target="_blank" rel="noopener" title="Open full resolution in new tab">
                            <img src="${atom.cover_url}" alt="${escapeHtml(atom.title || 'Image asset')}" class="cur-lightbox-img" loading="eager">
                        </a>
                    </div>
                ` : ''}

                ${paletteDots}

                ${(atom.title && !atom.title.startsWith('atm_') && !/^[0-9a-f_-]{10,}$/i.test(atom.title)) ? `
                    <h2 class="cur-modal-title" style="font-size:22px; margin-bottom:6px;">${escapeHtml(atom.title)}</h2>
                ` : ''}

                ${bylineParts.length ? `<div class="cur-modal-byline">${bylineParts.join(' • ')}</div>` : ''}

                ${fullContent ? `
                    <div class="markdown-body" style="margin-bottom:16px;">
                        ${renderContentMarkdown(fullContent)}
                    </div>
                ` : ''}

                ${targetUrl ? `
                    <div class="cur-modal-actions">
                        <a href="${targetUrl}" target="_blank" rel="noopener" class="cur-modal-btn">↗ View Source Image</a>
                    </div>
                ` : ''}

                <!-- METADATA UNDERNEATH -->
                ${metaCardsHtml}
            `;
        } else if (atom.kind === 'video') {
            const embedUrl = getVideoEmbedUrl(atom, autoplayVideo);
            bodyHtml = `
                <!-- FULL VIDEO AT THE TOP -->
                ${embedUrl ? `
                    <div class="cur-modal-video-wrap">
                        <iframe src="${embedUrl}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                    </div>
                ` : (atom.cover_url ? `
                    <div class="cur-modal-cover-wrap">
                        <img src="${atom.cover_url}" alt="${escapeHtml(atom.title)}" class="cur-modal-cover-img">
                    </div>
                ` : '')}

                <h2 class="cur-modal-title">${escapeHtml(atom.title || 'Untitled Video')}</h2>
                ${bylineParts.length ? `<div class="cur-modal-byline">${bylineParts.join(' • ')}</div>` : ''}

                ${targetUrl ? `
                    <div class="cur-modal-actions">
                        <a href="${targetUrl}" target="_blank" rel="noopener" class="cur-modal-btn" style="background:#6B46C1;">▶ Watch on ${escapeHtml(siteName || 'Video Platform')} ↗</a>
                    </div>
                ` : ''}

                ${fullContent ? `
                    <div class="cur-modal-transcript-wrap">
                        <div class="cur-modal-transcript-heading">Transcript / Dialogue</div>
                        <div class="cur-modal-transcript-body">${escapeHtml(fullContent)}</div>
                    </div>
                ` : ''}

                <!-- METADATA UNDERNEATH -->
                ${metaCardsHtml}
            `;
        } else if (atom.kind === 'article') {
            bodyHtml = `
                <!-- FULL ARTICLE AT THE TOP -->
                ${atom.cover_url ? `
                    <div class="cur-modal-cover-wrap">
                        <img src="${atom.cover_url}" alt="${escapeHtml(atom.title)}" class="cur-modal-cover-img" loading="lazy">
                    </div>
                ` : ''}

                <h2 class="cur-modal-title">${escapeHtml(atom.title || 'Untitled Article')}</h2>
                ${bylineParts.length ? `<div class="cur-modal-byline">${bylineParts.join(' • ')}</div>` : ''}

                ${targetUrl ? `
                    <div class="cur-modal-actions">
                        <a href="${targetUrl}" target="_blank" rel="noopener" class="cur-modal-btn">↗ Read on ${escapeHtml(siteName || 'Publisher')}</a>
                    </div>
                ` : ''}

                ${fullContent ? `
                    <div class="cur-modal-article-text markdown-body">
                        ${renderContentMarkdown(fullContent)}
                    </div>
                ` : ''}

                <!-- METADATA UNDERNEATH -->
                ${metaCardsHtml}
            `;
        } else if (atom.kind === 'note') {
            bodyHtml = `
                <!-- FULL NOTE AT THE TOP -->
                <h2 class="cur-modal-title">${escapeHtml(atom.title || 'Personal Note')}</h2>
                ${bylineParts.length ? `<div class="cur-modal-byline">${bylineParts.join(' • ')}</div>` : ''}

                <div class="cur-modal-note-text markdown-body">
                    ${renderContentMarkdown(fullContent || atom.notes || '')}
                </div>

                <!-- METADATA UNDERNEATH -->
                ${metaCardsHtml}
            `;
        } else {
            // Bookmark / File / Other
            bodyHtml = `
                ${atom.cover_url ? `
                    <div class="cur-modal-cover-wrap">
                        <img src="${atom.cover_url}" alt="${escapeHtml(atom.title)}" class="cur-modal-cover-img" loading="lazy">
                    </div>
                ` : ''}

                <h2 class="cur-modal-title">${escapeHtml(atom.title || 'Untitled')}</h2>
                ${bylineParts.length ? `<div class="cur-modal-byline">${bylineParts.join(' • ')}</div>` : ''}

                ${targetUrl ? `
                    <div class="cur-modal-actions">
                        <a href="${targetUrl}" target="_blank" rel="noopener" class="cur-modal-btn">↗ Visit Link</a>
                    </div>
                ` : ''}

                ${fullContent ? `
                    <div class="markdown-body" style="margin-bottom:14px;">
                        ${renderContentMarkdown(fullContent)}
                    </div>
                ` : ''}

                <!-- METADATA UNDERNEATH -->
                ${metaCardsHtml}
            `;
        }

        const body = document.getElementById('curMetaBody');
        body.innerHTML = bodyHtml;
        modal.showModal();
    };

    window.copyCurId = function() {
        if (!window.currentMetaAtomId) return;
        navigator.clipboard.writeText(window.currentMetaAtomId).then(() => {
            const btn = document.getElementById('curCopyIdBtn');
            const orig = btn.textContent;
            btn.textContent = '✓ Copied!';
            setTimeout(() => btn.textContent = orig, 1800);
        });
    };

    // Filter Buttons
    document.querySelectorAll('.cur-tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.cur-tab-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            activeFilter = btn.dataset.filter;
            applyFilters();
        });
    });

    // Search Input
    document.getElementById('curationSearch').addEventListener('input', (e) => {
        searchQuery = e.target.value.trim();
        applyFilters();
    });

    // Keyboard shortcut '/'
    window.addEventListener('keydown', (e) => {
        if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
        if (e.key === '/') {
            e.preventDefault();
            document.getElementById('curationSearch').focus();
        }
    });

    // Load More Button
    document.getElementById('loadMoreBtn').addEventListener('click', renderNextBatch);

    // Close dialogs on backdrop click
    ['curVideoModal', 'curReaderModal', 'curMetaModal'].forEach(id => {
        const d = document.getElementById(id);
        if (d) {
            d.addEventListener('click', (e) => {
                const r = d.getBoundingClientRect();
                if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) d.close();
            });
            d.addEventListener('close', () => {
                if (id === 'curMetaModal') {
                    const b = document.getElementById('curMetaBody');
                    if (b) b.innerHTML = '';
                } else if (id === 'curVideoModal') {
                    const b = document.getElementById('curVideoBody');
                    if (b) b.innerHTML = '';
                }
            });
        }
    });

    // Init
    loadCurationData();
})();
</script>
