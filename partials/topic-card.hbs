<a class="topic-card topic-card-{{slug}}" href="{{url}}">
    <div class="topic-card-header">
        {{#if feature_image}}
            <div class="topic-avatar u-placeholder square">
                <img class="u-object-fit" src="{{img_url feature_image size="s"}}" alt="{{name}}" loading="lazy" decoding="async">
            </div>
        {{else}}
            <div class="topic-avatar topic-avatar-placeholder">
                <span class="topic-avatar-initial">#</span>
            </div>
        {{/if}}
        <div class="topic-card-title-group">
            <h3 class="topic-card-name">{{name}}</h3>
            <span class="topic-card-count">{{plural count.posts empty=(t "0 posts") singular=(t "1 post") plural=(t "% posts")}}</span>
        </div>
    </div>
    {{#if description}}
        <p class="topic-card-description">{{description}}</p>
    {{/if}}
</a>
